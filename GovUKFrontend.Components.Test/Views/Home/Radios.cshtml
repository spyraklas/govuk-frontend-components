@model RadiosModel
@{
    ViewData["Title"] = "Radios Component";
    string radioId = "RadioTest";
}

<form method="post" asp-action="Radios">
    <gds-row id="main-content" class="govuk-body" title="Main Content">
        <gds-column id="main-content-left-column" style="TwoThirds" class="govuk-body" title="Main Content Column">

            <gds-caption id="heading-caption" size="Large" title="">Testing Radios Component</gds-caption>
            <gds-heading type="H1" size="Large">Test Project for GDS Components</gds-heading>

            <gds-row id="radios-test-content" class="govuk-body" title="Radios Test Content">
                <gds-column style="Full">
                    <gds-radios id="@radioId" class="test-class" model-state="@ViewBag.ModelState" caption="Test Radios Group" caption-size="Medium" label-type="Label" hint="Test Radios Hint" hint-class="hint-test-class">

                        <gds-radio-item id="Radio1" name="@radioId" class="radio-test-class" model-value="@Model.RadioTest" value="Radio1" caption="Test radio 1" hint="hint for radio 1">
                            <p class="govuk-body">This is a contitional HTML content for radio 1</p>
                        </gds-radio-item>

                        <gds-radio-item id="Radio2" name="@radioId" class="radio-test-class2" model-value="@Model.RadioTest" value="Radio2" caption="Test radio 2" hint="hint for radio 2">
                            <p class="govuk-body">This is a contitional HTML content for radio 2</p><br />
                            <gds-button id="GoToButton" href="/Home/Button" target="Self" button-style="Primary" button-type="Link">Go to button page</gds-button>
                        </gds-radio-item>

                        <gds-radio-divider id="test-divider" class="test-class-divider">
                            <p class="govuk-body">or</p>
                        </gds-radio-divider>

                        <gds-radio-item id="Radio3" name="@radioId" class="radio-test-class3" model-value="@Model.RadioTest" value="Radio3" caption="Test radio 3" hint="hint for radio 3">
                        </gds-radio-item>
                    </gds-radios>
                    <gds-button id="submit-button" name="submit-button" button-type="Submit" button-style="Primary" title="Submit Button">Submit</gds-button>
                </gds-column>
            </gds-row>

        </gds-column>
        <gds-column id="main-content-right-column" class="govuk-body" style="OneThird" title="Main Content Right Column">

            <img src="https://dfeconnect.education.gov.uk/images/dfe-logo-alt.png" height="120px" alt="DfE logo" title="Dfe Logo" />
            <br /><br />
            <partial name="_Menu" />

        </gds-column>
    </gds-row>
</form>
